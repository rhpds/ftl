#!/bin/bash
# FTL Grade Lab Wrapper
# Usage: grade_lab <lab-name> [user] [module-number] [--podman|--ansible]
# Examples:
#   grade_lab mcp-with-openshift user1 1 --podman   # Run via container (laptop)
#   grade_lab mcp-with-openshift user1 1 --ansible  # Run via ansible-playbook (bastion)
#   grade_lab mcp-with-openshift user1              # Defaults to --ansible if available, else --podman

set -e

# ── Extract --podman / --ansible flag from args ───────────────────────────────
RUNNER=""
CLEAN_ARGS=()
for arg in "$@"; do
  case "$arg" in
    --podman)  RUNNER="podman" ;;
    --ansible) RUNNER="ansible" ;;
    *)         CLEAN_ARGS+=("$arg") ;;
  esac
done
set -- "${CLEAN_ARGS[@]}"

# Default: ansible if available, podman otherwise
if [ -z "$RUNNER" ]; then
  command -v ansible-playbook &>/dev/null && RUNNER="ansible" || RUNNER="podman"
fi

# ── Podman / container mode ───────────────────────────────────────────────────
if [ "$RUNNER" = "podman" ]; then
  FTL_IMAGE="${FTL_IMAGE:-quay.io/rhpds/ftl:latest}"

  ENV_ARGS=()
  for var in LAB_USER PASSWORD OPENSHIFT_CLUSTER_INGRESS_DOMAIN \
             AAP_HOSTNAME AAP_PASSWORD AAP_USERNAME \
             BASTION_HOST BASTION_USER GUID \
             GITEA_ADMIN_USER GITEA_ADMIN_PASSWORD; do
    [ -n "${!var:-}" ] && ENV_ARGS+=(-e "$var=${!var}")
  done

  KUBE_ARGS=()
  [ -f "${HOME}/.kube/config" ] && KUBE_ARGS=(-v "${HOME}/.kube/config:/home/runner/.kube/config:ro")

  # ── 'all' user: discover users from showroom namespaces and run in parallel ──
  # Usage: grade_lab <lab> all [module] --podman
  FIRST_NON_FLAG_ARG=""
  for a in "$@"; do [[ "$a" != --* ]] && { FIRST_NON_FLAG_ARG="$a"; break; }; done

  # Check if the user arg (2nd arg after lab name) is 'all'
  LAB_NAME="${1:-}"
  if [ "${2:-}" = "all" ]; then
    shift 2  # remove lab name and 'all' — remaining is [module] if any
    MODULE_ARG="${1:-}"

    # Log in using env vars if kubeconfig not already set or API_URL provided
    if [ -n "${OCP_API_URL:-}" ]; then
      oc login "$OCP_API_URL" \
        -u "${OCP_ADMIN_USER:-admin}" \
        -p "${OCP_ADMIN_PASSWORD:-${PASSWORD:-}}" \
        --insecure-skip-tls-verify=true &>/dev/null || true
    fi

    # Discover users from showroom namespaces
    USERS=$((kubectl get namespaces --no-headers -o name 2>/dev/null || oc get namespaces --no-headers -o name 2>/dev/null) \
      | grep "showroom" | sed 's/.*-\(user[0-9]*\)$/\1/' | grep '^user' | sort -u || true)

    if [ -z "$USERS" ]; then
      echo "No showroom user namespaces found — ensure kubeconfig is set and cluster is accessible"
      exit 1
    fi

    echo "Discovered users: $(echo $USERS | tr '\n' ' ')"
    echo "Running grader in parallel for all users..."
    echo ""

    PIDS=()
    for user in $USERS; do
      (
        export LAB_USER="$user"
        # Read all credentials from showroom ConfigMap for this user
        NS=$((kubectl get namespaces --no-headers -o name 2>/dev/null || oc get namespaces --no-headers -o name 2>/dev/null) \
          | grep "showroom" | grep "${user}$" | head -1 | cut -d/ -f2 || true)
        if [ -n "$NS" ]; then
          RAW=$(oc get configmap showroom-userdata -n "$NS" \
            -o jsonpath='{.data.user_data\.yml}' 2>/dev/null || true)
          if [ -n "$RAW" ]; then
            extract() { echo "$RAW" | grep "\"$1\":" | head -1 | sed "s/.*\"$1\": *\"\\([^\"]*\\)\".*/\\1/"; }
            USER_PASS=$(extract "password")
            GITEA_ADM_USER=$(extract "gitea_admin_username")
            GITEA_ADM_PASS=$(extract "gitea_admin_password")
            [ -n "$USER_PASS" ]     && export PASSWORD="$USER_PASS"
            [ -n "$GITEA_ADM_USER" ] && export GITEA_ADMIN_USER="$GITEA_ADM_USER"
            [ -n "$GITEA_ADM_PASS" ] && export GITEA_ADMIN_PASSWORD="$GITEA_ADM_PASS"
          fi
        fi
        echo "▶ Grading $LAB_NAME as $user ${MODULE_ARG:+(module $MODULE_ARG)}..."
        if [ -n "$MODULE_ARG" ]; then
          "$0" "${LAB_NAME}" "$user" "$MODULE_ARG" --podman
        else
          "$0" "${LAB_NAME}" "$user" --podman
        fi
      ) &
      PIDS+=($!)
    done

    # Wait for all and collect results
    EXIT_CODE=0
    for pid in "${PIDS[@]}"; do
      wait "$pid" || EXIT_CODE=1
    done
    REPORT_DIR="${FTL_REPORT_DIR:-${HOME}/ftl-reports}"
    echo ""
    echo "═══════════════════════════════════════════════════════"
    echo "Grading complete. Reports saved to: $REPORT_DIR"
    ls "$REPORT_DIR"/grading_report_*_module_*.txt 2>/dev/null | sed "s|${REPORT_DIR}/||" | sed 's/^/  /'
    echo "═══════════════════════════════════════════════════════"
    exit $EXIT_CODE
  fi

  # Mount local report dir if set (default: ~/ftl-reports)
  REPORT_DIR="${FTL_REPORT_DIR:-${HOME}/ftl-reports}"
  mkdir -p "$REPORT_DIR"
  REPORT_ARGS=(-v "$REPORT_DIR:/tmp/grading_dir")

  exec podman run --rm "${KUBE_ARGS[@]}" "${ENV_ARGS[@]}" "${REPORT_ARGS[@]}" \
    -e ANSIBLE_FORCE_COLOR=true \
    "$FTL_IMAGE" grade "$@"
fi

# ── Ansible / bastion mode (continues below) ──────────────────────────────────

# Configuration
FTL_REPO="https://github.com/rhpds/ftl.git"
FTL_DIR="${HOME}/ftl"

# Colors for output
GREEN='\033[0;32m'
BLUE='\033[0;34m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Parse arguments
LAB_NAME="${1}"
ARG2="${2}"
ARG3="${3}"

# Smart argument parsing
# If ARG2 is a number, it's a module number (user from env)
# If ARG2 is not a number, it's a user (module from ARG3)
if [[ "${ARG2}" =~ ^[0-9]+$ ]]; then
    # ARG2 is a number, so it's a module number
    MODULE_NUM="${ARG2}"
    USER_OVERRIDE=""
else
    # ARG2 is not a number, so it's a user
    USER_OVERRIDE="${ARG2}"
    MODULE_NUM="${ARG3}"
fi

if [ -z "${LAB_NAME}" ]; then
    echo -e "${RED}Error: Lab name required${NC}"
    echo "Usage: grade_lab <lab-name> [user] [module-number]"
    echo ""
    echo "Examples:"
    echo "  grade_lab mcp-with-openshift              # Grade all modules for \$LAB_USER"
    echo "  grade_lab mcp-with-openshift 1            # Grade module 1 for \$LAB_USER"
    echo "  grade_lab mcp-with-openshift user2        # Grade all modules for user2"
    echo "  grade_lab mcp-with-openshift user2 1      # Grade module 1 for user2"
    echo ""
    echo "Available labs:"
    ls -1 "${FTL_DIR}/labs" 2>/dev/null || echo "  (FTL not installed yet)"
    exit 1
fi

# Setup/update FTL repository
if [ ! -d "${FTL_DIR}" ]; then
    echo -e "${BLUE}Installing FTL...${NC}"
    git clone "${FTL_REPO}" "${FTL_DIR}"
else
    echo -e "${BLUE}Updating FTL...${NC}"
    cd "${FTL_DIR}"
    git pull --quiet || true
fi

cd "${FTL_DIR}"

# Setup virtual environment and dependencies if needed
if [ ! -d ".venv" ]; then
    echo -e "${BLUE}Setting up Python environment (first time only)...${NC}"
    bash bin/setup_ftl
fi

# Activate virtual environment
if [ -f ".venv/bin/activate" ]; then
    source .venv/bin/activate
fi

# Check if lab exists
if [ ! -d "labs/${LAB_NAME}" ]; then
    echo -e "${RED}Error: Lab '${LAB_NAME}' not found${NC}"
    echo "Available labs:"
    ls -1 labs/
    exit 1
fi

# Set LAB_USER (priority: command arg > LAB_USER env > USER env)
if [ -n "${USER_OVERRIDE}" ]; then
    export LAB_USER="${USER_OVERRIDE}"
elif [ -z "${LAB_USER}" ]; then
    export LAB_USER="${USER}"
fi

# Set GUID from hostname if not set
export GUID="${GUID:-$(hostname | cut -d'-' -f2)}"

echo -e "${GREEN}========================================${NC}"
echo -e "${GREEN}FTL Lab Grader${NC}"
echo -e "${GREEN}========================================${NC}"
echo -e "Lab:      ${BLUE}${LAB_NAME}${NC}"
echo -e "User:     ${BLUE}${LAB_USER}${NC}"
echo -e "GUID:     ${BLUE}${GUID}${NC}"

# Determine which playbook to run
if [ -n "${MODULE_NUM}" ]; then
    # Grade specific module
    MODULE_FILE="labs/${LAB_NAME}/grade_module_$(printf "%02d" ${MODULE_NUM}).yml"

    if [ ! -f "${MODULE_FILE}" ]; then
        echo -e "${RED}Error: Module ${MODULE_NUM} not found${NC}"
        echo "Available modules:"
        ls -1 labs/${LAB_NAME}/grade_module_*.yml 2>/dev/null | sed 's/.*grade_module_/  Module /' | sed 's/.yml//'
        exit 1
    fi

    echo -e "Module:   ${BLUE}${MODULE_NUM}${NC}"
    echo -e "${GREEN}========================================${NC}"
    echo ""

    # Check if lab has custom inventory
    if [ -f "labs/${LAB_NAME}/inventory" ]; then
        ansible-playbook -i "labs/${LAB_NAME}/inventory" "${MODULE_FILE}"
    else
        ansible-playbook "${MODULE_FILE}"
    fi
else
    # Grade all modules in order
    MODULE_FILES=$(ls -1 labs/${LAB_NAME}/grade_module_*.yml 2>/dev/null | sort)
    if [ -z "${MODULE_FILES}" ]; then
        echo -e "${RED}Error: No grader modules found for '${LAB_NAME}'${NC}"
        exit 1
    fi

    echo -e "Grading:  ${BLUE}All modules${NC}"
    echo -e "${GREEN}========================================${NC}"
    echo ""

    for MODULE_FILE in ${MODULE_FILES}; do
        MOD_NUM=$(echo "${MODULE_FILE}" | sed 's/.*grade_module_//' | sed 's/.yml//' | sed 's/^0*//')
        echo -e "${BLUE}--- Grading Module ${MOD_NUM} ---${NC}"
        if [ -f "labs/${LAB_NAME}/inventory" ]; then
            ansible-playbook -i "labs/${LAB_NAME}/inventory" "${MODULE_FILE}"
        else
            ansible-playbook "${MODULE_FILE}"
        fi
        echo ""
    done
fi

# Display report
echo ""
echo -e "${GREEN}========================================${NC}"
echo -e "${GREEN}Grading Report${NC}"
echo -e "${GREEN}========================================${NC}"

if [ -n "${MODULE_NUM}" ]; then
    # Single module report
    REPORT_FILE="/tmp/grading_dir/grading_report_${LAB_USER}_module_$(printf "%02d" ${MODULE_NUM}).txt"

    if [ -f "${REPORT_FILE}" ]; then
        cat "${REPORT_FILE}"

        LAST_RESULT=$(grep -E "^(SUCCESS|FAILED)" "${REPORT_FILE}" | tail -1)

        if echo "${LAST_RESULT}" | grep -q "SUCCESS 0 Errors"; then
            echo ""
            echo -e "${GREEN}✓ Lab grading PASSED!${NC}"
            echo -e "${GREEN}Report: ${REPORT_FILE}${NC}"
            exit 0
        else
            echo ""
            echo -e "${YELLOW}✗ Lab grading FAILED - see report above${NC}"
            echo -e "${YELLOW}Report: ${REPORT_FILE}${NC}"
            exit 1
        fi
    else
        echo -e "${RED}Error: Report file not found: ${REPORT_FILE}${NC}"
        exit 1
    fi
else
    # All modules - check each module's report
    OVERALL_PASS=true
    for MODULE_FILE in ${MODULE_FILES}; do
        MOD_NUM=$(echo "${MODULE_FILE}" | sed 's/.*grade_module_//' | sed 's/.yml//')
        MOD_REPORT="/tmp/grading_dir/grading_report_${LAB_USER}_module_${MOD_NUM}.txt"
        if [ -f "${MOD_REPORT}" ]; then
            cat "${MOD_REPORT}"
            echo ""
            LAST_RESULT=$(grep -E "^(SUCCESS|FAILED)" "${MOD_REPORT}" | tail -1)
            if ! echo "${LAST_RESULT}" | grep -q "SUCCESS 0 Errors"; then
                OVERALL_PASS=false
            fi
        else
            echo -e "${YELLOW}Warning: Report not found for module ${MOD_NUM}: ${MOD_REPORT}${NC}"
            OVERALL_PASS=false
        fi
    done

    if [ "${OVERALL_PASS}" = true ]; then
        echo -e "${GREEN}✓ All modules PASSED!${NC}"
        exit 0
    else
        echo -e "${YELLOW}✗ Some modules FAILED - see reports above${NC}"
        exit 1
    fi
fi
