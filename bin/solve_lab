#!/bin/bash
# FTL Solve Lab Wrapper
# Usage: solve_lab <lab-name> [user] [module-number] [--podman|--ansible]
# Examples:
#   solve_lab mcp-with-openshift user1 1 --podman   # Run via container (laptop)
#   solve_lab mcp-with-openshift user1 1 --ansible  # Run via ansible-playbook (bastion)
#   solve_lab mcp-with-openshift user1              # Defaults to --ansible if available, else --podman

set -e

# ── Extract --podman / --ansible flag from args ───────────────────────────────
RUNNER=""
CLEAN_ARGS=()
for arg in "$@"; do
  case "$arg" in
    --podman)  RUNNER="podman" ;;
    --ansible) RUNNER="ansible" ;;
    *)         CLEAN_ARGS+=("$arg") ;;
  esac
done
set -- "${CLEAN_ARGS[@]}"

# Default: ansible if available, podman otherwise
if [ -z "$RUNNER" ]; then
  command -v ansible-playbook &>/dev/null && RUNNER="ansible" || RUNNER="podman"
fi

# ── Podman / container mode ───────────────────────────────────────────────────
if [ "$RUNNER" = "podman" ]; then
  FTL_IMAGE="${FTL_IMAGE:-quay.io/rhpds/ftl:latest}"

  ENV_ARGS=()
  for var in LAB_USER PASSWORD OPENSHIFT_CLUSTER_INGRESS_DOMAIN \
             AAP_HOSTNAME AAP_PASSWORD AAP_USERNAME \
             BASTION_HOST BASTION_USER GUID \
             GITEA_ADMIN_USER GITEA_ADMIN_PASSWORD; do
    [ -n "${!var:-}" ] && ENV_ARGS+=(-e "$var=${!var}")
  done

  KUBE_ARGS=()
  [ -f "${HOME}/.kube/config" ] && KUBE_ARGS=(-v "${HOME}/.kube/config:/home/runner/.kube/config:ro")

  # ── 'all' user: discover from showroom namespaces, run in parallel ────────────
  if [ "${2:-}" = "all" ]; then
    shift 2  # remove lab name and 'all'
    MODULE_ARG="${1:-}"

    # Log in using env vars if OCP_API_URL provided
    if [ -n "${OCP_API_URL:-}" ]; then
      oc login "$OCP_API_URL" \
        -u "${OCP_ADMIN_USER:-admin}" \
        -p "${OCP_ADMIN_PASSWORD:-${PASSWORD:-}}" \
        --insecure-skip-tls-verify=true &>/dev/null || true
    fi

    USERS=$((kubectl get namespaces --no-headers -o name 2>/dev/null || oc get namespaces --no-headers -o name 2>/dev/null) \
      | grep "showroom" | sed 's/.*-\(user[0-9]*\)$/\1/' | grep '^user' | sort -u || true)

    if [ -z "$USERS" ]; then
      echo "No showroom user namespaces found — ensure kubeconfig is set"
      exit 1
    fi

    echo "Discovered users: $(echo $USERS | tr '\n' ' ')"
    echo "Running solver in parallel for all users..."

    PIDS=()
    for user in $USERS; do
      (
        export LAB_USER="$user"
        NS=$((kubectl get namespaces --no-headers -o name 2>/dev/null || oc get namespaces --no-headers -o name 2>/dev/null) \
          | grep "showroom" | grep "${user}$" | head -1 | cut -d/ -f2 || true)
        if [ -n "$NS" ]; then
          USER_PASS=$((kubectl get configmap showroom-userdata -n "$NS" 2>/dev/null || oc get configmap showroom-userdata -n "$NS" 2>/dev/null) \
            -o jsonpath='{.data.user_data\.yml}' 2>/dev/null \
            | grep '"password":' | head -1 \
            | sed 's/.*"password": *"\([^"]*\)".*/\1/' || true)
          [ -n "$USER_PASS" ] && export PASSWORD="$USER_PASS"
        fi
        if [ -n "$MODULE_ARG" ]; then
          "$0" "${LAB_NAME}" "$user" "$MODULE_ARG" --podman
        else
          "$0" "${LAB_NAME}" "$user" --podman
        fi
      ) &
      PIDS+=($!)
    done

    EXIT_CODE=0
    for pid in "${PIDS[@]}"; do wait "$pid" || EXIT_CODE=1; done
    exit $EXIT_CODE
  fi

  exec podman run --rm "${KUBE_ARGS[@]}" "${ENV_ARGS[@]}" \
    -e ANSIBLE_FORCE_COLOR=true \
    "$FTL_IMAGE" solve "$@"
fi

# ── Ansible / bastion mode (continues below) ──────────────────────────────────

# Configuration
FTL_REPO="https://github.com/rhpds/ftl.git"
FTL_DIR="${HOME}/ftl"

# Colors for output
GREEN='\033[0;32m'
BLUE='\033[0;34m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Parse arguments
LAB_NAME="${1}"
ARG2="${2}"
ARG3="${3}"

# Smart argument parsing
# If ARG2 is a number, it's a module number (user from env)
# If ARG2 is not a number, it's a user (module from ARG3)
if [[ "${ARG2}" =~ ^[0-9]+$ ]]; then
    # ARG2 is a number, so it's a module number
    MODULE_NUM="${ARG2}"
    USER_OVERRIDE=""
else
    # ARG2 is not a number, so it's a user
    USER_OVERRIDE="${ARG2}"
    MODULE_NUM="${ARG3}"
fi

if [ -z "${LAB_NAME}" ]; then
    echo -e "${RED}Error: Lab name required${NC}"
    echo "Usage: solve_lab <lab-name> [user] [module-number]"
    echo ""
    echo "Examples:"
    echo "  solve_lab mcp-with-openshift              # Solve all modules for \$LAB_USER"
    echo "  solve_lab mcp-with-openshift 1            # Solve module 1 for \$LAB_USER"
    echo "  solve_lab mcp-with-openshift user2        # Solve all modules for user2"
    echo "  solve_lab mcp-with-openshift user2 1      # Solve module 1 for user2"
    echo ""
    echo "Available labs:"
    ls -1 "${FTL_DIR}/labs" 2>/dev/null || echo "  (FTL not installed yet)"
    exit 1
fi

# Setup/update FTL repository
if [ ! -d "${FTL_DIR}" ]; then
    echo -e "${BLUE}Installing FTL...${NC}"
    git clone "${FTL_REPO}" "${FTL_DIR}"
else
    echo -e "${BLUE}Updating FTL...${NC}"
    cd "${FTL_DIR}"
    git pull --quiet || true
fi

cd "${FTL_DIR}"

# Setup virtual environment and dependencies if needed
if [ ! -d ".venv" ]; then
    echo -e "${BLUE}Setting up Python environment (first time only)...${NC}"
    bash bin/setup_ftl
fi

# Activate virtual environment
if [ -f ".venv/bin/activate" ]; then
    source .venv/bin/activate
fi

# Check if lab exists
if [ ! -d "labs/${LAB_NAME}" ]; then
    echo -e "${RED}Error: Lab '${LAB_NAME}' not found${NC}"
    echo "Available labs:"
    ls -1 labs/
    exit 1
fi

# Set LAB_USER (priority: command arg > LAB_USER env > USER env)
if [ -n "${USER_OVERRIDE}" ]; then
    export LAB_USER="${USER_OVERRIDE}"
elif [ -z "${LAB_USER}" ]; then
    export LAB_USER="${USER}"
fi

# Set GUID from hostname if not set
export GUID="${GUID:-$(hostname | cut -d'-' -f2)}"

echo -e "${GREEN}========================================${NC}"
echo -e "${GREEN}FTL Lab Solver${NC}"
echo -e "${GREEN}========================================${NC}"
echo -e "Lab:      ${BLUE}${LAB_NAME}${NC}"
echo -e "User:     ${BLUE}${LAB_USER}${NC}"
echo -e "GUID:     ${BLUE}${GUID}${NC}"

# Determine which playbook to run
if [ -n "${MODULE_NUM}" ]; then
    # Solve specific module
    MODULE_FILE="labs/${LAB_NAME}/solve_module_$(printf "%02d" ${MODULE_NUM}).yml"

    if [ ! -f "${MODULE_FILE}" ]; then
        echo -e "${RED}Error: Module ${MODULE_NUM} not found${NC}"
        echo "Available modules:"
        ls -1 labs/${LAB_NAME}/solve_module_*.yml 2>/dev/null | sed 's/.*solve_module_/  Module /' | sed 's/.yml//'
        exit 1
    fi

    echo -e "Module:   ${BLUE}${MODULE_NUM}${NC}"
    echo -e "${GREEN}========================================${NC}"
    echo ""

    # Check if lab has custom inventory
    if [ -f "labs/${LAB_NAME}/inventory" ]; then
        ansible-playbook -i "labs/${LAB_NAME}/inventory" "${MODULE_FILE}"
    else
        ansible-playbook "${MODULE_FILE}"
    fi
else
    # Solve all modules in order
    MODULE_FILES=$(ls -1 labs/${LAB_NAME}/solve_module_*.yml 2>/dev/null | sort)
    if [ -z "${MODULE_FILES}" ]; then
        echo -e "${RED}Error: No solver modules found for '${LAB_NAME}'${NC}"
        exit 1
    fi

    echo -e "Solving:  ${BLUE}All modules${NC}"
    echo -e "${GREEN}========================================${NC}"
    echo ""

    for MODULE_FILE in ${MODULE_FILES}; do
        MOD_NUM=$(echo "${MODULE_FILE}" | sed 's/.*solve_module_//' | sed 's/.yml//' | sed 's/^0*//')
        echo -e "${BLUE}--- Solving Module ${MOD_NUM} ---${NC}"
        if [ -f "labs/${LAB_NAME}/inventory" ]; then
            ansible-playbook -i "labs/${LAB_NAME}/inventory" "${MODULE_FILE}"
        else
            ansible-playbook "${MODULE_FILE}"
        fi
        echo ""
    done
fi

echo ""
echo -e "${GREEN}✓ Lab solving completed!${NC}"
echo ""
if [ -n "${MODULE_NUM}" ]; then
    echo -e "${YELLOW}Run 'grade_lab ${LAB_NAME} ${LAB_USER} ${MODULE_NUM}' to verify the solution${NC}"
else
    echo -e "${YELLOW}Run 'grade_lab ${LAB_NAME} ${LAB_USER}' to verify the solution${NC}"
fi
exit 0
